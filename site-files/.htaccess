# =========================================
# RCS True Facilities - .htaccess
# =========================================

# Deny directory listing
Options -Indexes

# Prevent directory browsing
<IfModule mod_autoindex.c>
    Options -Indexes
</IfModule>

# Block known malicious IPs
<RequireAll>
    Require all granted
    Require not ip 107.173.224.217
    Require not ip 23.95.23.114
</RequireAll>
