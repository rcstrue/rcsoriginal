# =========================================
# Strict .htaccess for HR/payroll security
# =========================================

# 1️⃣ Protect sensitive files (PHP, HTML, PDFs)
<FilesMatch "^(salary|payslip|pfesicchallan|Joining_Letter|view_joining_letters|letters/.*)\.(php|html|tmp|pdf)$">
    Require all denied
</FilesMatch>

# 2️⃣ Deny directory listing
Options -Indexes

# 3️⃣ Block known malicious IPs
<RequireAll>
    Require all granted
    Require not ip 107.173.224.217
    Require not ip 23.95.23.114
</RequireAll>

# 4️⃣ Prevent hotlinking / external access to PDFs
RewriteEngine On
RewriteCond %{HTTP_REFERER} !^https://(www\.)?yourdomain\.com/ [NC]
RewriteRule ^letters/.*\.pdf$ - [F,L]

# 5️⃣ Block rapid requests (basic rate limiting)
# Limit: max 10 requests per 10 seconds per IP
<IfModule mod_ratelimit.c>
    SetEnvIf Request_URI ".*" LIMIT_RATE
</IfModule>

<IfModule mod_evasive20.c>
    DOSHashTableSize 3097
    DOSPageCount 10
    DOSSiteCount 50
    DOSPageInterval 1
    DOSSiteInterval 1
    DOSBlockingPeriod 600
</IfModule>

# 6️⃣ Custom 403 page
ErrorDocument 403 /403.html